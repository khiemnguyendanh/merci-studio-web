{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mercistudio-cloud",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Kho ảnh album (img.mercistudio.net). Nút admin "Đồng bộ Drive → R2" ghi vào photos/.
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "merci-photos"
    }
  ],
  "observability": {
    "enabled": true
  }
}
