{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mercistudio-cloud",
  // custom-worker.ts bọc .open-next/worker.js: cache HTML ở biên + chặn bot dò lỗ hổng.
  "main": "custom-worker.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Kho ảnh album (img.mercistudio.net). Nút admin "Đồng bộ Drive → R2" ghi vào photos/.
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "merci-photos"
    }
  ],
  // ID phiên bản deploy, dùng làm khoá cache HTML (deploy mới tự bỏ cache cũ).
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  }
}
