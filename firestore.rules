rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'khiemnguyendanh@gmail.com'
      );
    }

    function validSelection() {
      return request.resource.data.keys().hasOnly([
        'folderId', 'userKey', 'userEmail', 'userName', 'userType',
        'selectedIds', 'imageNotes', 'updatedAt'
      ]) &&
      request.resource.data.folderId is string &&
      request.resource.data.userKey is string &&
      request.resource.data.userName is string &&
      request.resource.data.userType in ['gmail', 'guest'] &&
      request.resource.data.selectedIds is list &&
      request.resource.data.selectedIds.size() <= 5000 &&
      request.resource.data.imageNotes is map;
    }

    // Chủ sở hữu bản ghi chọn ảnh: khách ẩn danh (key ngẫu nhiên trong máy khách)
    // hoặc user Firebase đăng nhập đúng email — chặn ghi đè chéo giữa các khách.
    function selectionOwnerAllowed() {
      return request.resource.data.userType == 'guest' ||
        (signedIn() && request.resource.data.userType == 'gmail' &&
          request.resource.data.userEmail == request.auth.token.email);
    }

    match /client_pages/{pageId} {
      allow get: if true;
      allow list: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /client_selections/{selectionId} {
      allow get: if true;
      allow list: if isAdmin();
      // Doc id luôn là `${folderId}_${userKey}`; update không được đổi chủ sở hữu.
      allow create: if validSelection() &&
        selectionOwnerAllowed() &&
        selectionId == request.resource.data.folderId + '_' + request.resource.data.userKey;
      allow update: if validSelection() &&
        resource.data.userKey == request.resource.data.userKey &&
        resource.data.folderId == request.resource.data.folderId &&
        resource.data.userType == request.resource.data.userType &&
        selectionOwnerAllowed() &&
        selectionId == request.resource.data.folderId + '_' + request.resource.data.userKey;
      allow delete: if isAdmin();
    }

    match /merci_albums/{albumId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /merci_videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /merci_blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /merci_bookings/{bookingId} {
      allow read, write: if isAdmin();
    }

    match /merci_sessions/{sessionId} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.id == sessionId &&
        request.resource.data.keys().hasOnly([
          'id', 'createdAt', 'dateStr', 'visitedHome', 'visitedCollection',
          'visitedVideos', 'visitedBlog', 'visitedBooking', 'completedBooking',
          'albumViews', 'timeSpent', 'updatedAt'
        ]);
      allow update: if request.resource.data.id == resource.data.id &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.keys().hasOnly([
          'id', 'createdAt', 'dateStr', 'visitedHome', 'visitedCollection',
          'visitedVideos', 'visitedBlog', 'visitedBooking', 'completedBooking',
          'albumViews', 'timeSpent', 'updatedAt'
        ]);
    }

    match /merci_users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
