rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Client selection links created by admin
    match /client_pages/{pageId} {
      allow read, write: if true;
    }

    // 2. Client selected images and notes
    match /client_selections/{folderId} {
      allow read, write: if true;
    }

    // 3. Portfolio albums
    match /merci_albums/{albumId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. Portfolio videos
    match /merci_videos/{videoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 5. Portfolio blog posts
    match /merci_blogs/{blogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 6. Booking forms submitted by clients
    match /merci_bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // 7. Session analytics tracked for dashboard
    match /merci_sessions/{sessionId} {
      allow read, write: if true;
    }

    // 8. Spin registrations for lucky wheel promotion
    match /merci_spin_registrations/{regId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 9. Wheel configuration settings
    match /merci_wheel_config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 10. Customer profiles, loyalty points, and referrals
    match /merci_users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
